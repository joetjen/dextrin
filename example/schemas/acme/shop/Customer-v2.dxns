# The current version of a customer.
#
# Version 2 only appends fields to version 1, so an older reader of the
# binary form still finds every field it knows in the same position.

%{
  # Someone who buys from Acme.
  #
  # **Personal data**: everything here except `id` falls under the data
  # protection rules. Never log a customer, and never put one in an
  # event payload in full -- use `id`.
  Customer: %schema(2){
    id: :uuid
    name: acme.common/NonEmptyString
    email: acme.common/Email
    address: acme.common/Address
    # Where a parcel goes when it is not the main address.
    shipping_addresses?: {:list-of acme.common/Address}
    phone?: acme.common/PhoneNumber
    # The channel the customer prefers to be reached on.
    contact_by: %field{
      type: {:enum :email :phone :post}
      default: :email
    }
    registered_at: :timestamp
    # A small picture, at most a few kilobytes.
    avatar?: :bytes
    tags?: acme.common/Tags
    metadata?: acme.common/Metadata
  }
}
